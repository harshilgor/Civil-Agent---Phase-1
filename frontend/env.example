# Copy to .env.local (Next.js loads it automatically; ignored by git).

# Civil Agent FastAPI (uvicorn src.main:app --host 0.0.0.0 --port 8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SIZER_API_BASE_URL=http://localhost:8001

