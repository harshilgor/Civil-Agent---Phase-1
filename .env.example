# Civil Agent — Environment Configuration
# Copy to .env and fill in values

# General
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Database (future)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/civil_agent

# Redis / Celery (future)
REDIS_URL=redis://localhost:6379/0

# CV Model weights
# WALL_SEGMENTER_WEIGHTS=src/cv/models/wall_unet.pth
# SYMBOL_DETECTOR_WEIGHTS=src/cv/models/symbol_yolo.pt

# LLM
# Put the real key in .env (which is gitignored), NEVER in this file.
# ANTHROPIC_API_KEY=sk-ant-...

# AWS S3 (future)
# S3_BUCKET=civil-agent-uploads
# AWS_REGION=us-east-1

# Thresholds
DEFAULT_WALL_THICKNESS_MM=200.0
SNAP_TOLERANCE_MM=50.0
